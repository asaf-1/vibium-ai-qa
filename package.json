{
  "name": "vibium-ai-qa",
  "version": "0.1.0",
  "private": true,
  "description": "What is Vibium worth? Tested on Playground Bank.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 \"tests/e2e/**/*.spec.ts\"",
    "agent": "tsx --test --test-concurrency=1 \"tests/agent/**/*.spec.ts\"",
    "smoke": "tsx --test tests/e2e/sanity/smoke.spec.ts",
    "flow": "tsx --test tests/e2e/bank/transfer-own-accounts.spec.ts",
    "reliability": "tsx scripts/reliability.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vibium": "26.8.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
